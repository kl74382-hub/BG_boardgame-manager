# ==============================================================================
# BG Stats KR 환경변수 템플릿 (.env.example)
# ------------------------------------------------------------------------------
# 사용 방법:
#   1) 이 파일을 복사하여 프로젝트 루트에 `.env.local` 파일을 만듭니다.
#   2) Supabase 대시보드(Project Settings > API)에서 URL과 anon key를 입력합니다.
#   3) `npm run supabase:check` 로 연동 상태를 확인합니다.
#   4) Vercel 배포 시에도 Settings > Environment Variables에 동일하게 등록 후 Redeploy 합니다.
# ==============================================================================

# [필수 - Supabase 클라우드 연동]
# Supabase Project URL (예: https://abcdefghijklmno.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon / public API Key (Publishable key 또는 anon JWT)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# [선택 - 프로덕션 로컬 데모 모드 허용]
# Supabase 미연동 상태로 프로덕션 빌드에서 로컬 계정 로그인을 테스트할 때만 true로 설정
# NEXT_PUBLIC_ALLOW_LOCAL_DEMO=false
